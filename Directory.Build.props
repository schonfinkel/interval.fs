<Project>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Deterministic>true</Deterministic>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <WarnOn>3390;$(WarnOn)</WarnOn>
    </PropertyGroup>

    <!-- NuGet packaging metadata. The flake and the Makefile both read Version from here. -->
    <PropertyGroup>
        <Version>2.0.0</Version>
        <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <RepositoryUrl>https://github.com/schonfinkel/interval.fs</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>fsharp;interval;allen;algebra</PackageTags>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
</Project>
