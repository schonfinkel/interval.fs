<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsPublishable>false</IsPublishable>
        <IsPackable>false</IsPackable>
        <GenerateProgramFile>false</GenerateProgramFile>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Expecto" Version="11.1.1" />
        <PackageReference Include="Expecto.FsCheck" Version="11.1.1" />
        <PackageReference Include="FsCheck" Version="3.6.0" />
        <PackageReference Include="YoloDev.Expecto.TestSdk" Version="0.16.1" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
        <PackageReference Include="coverlet.msbuild" Version="10.1.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="Generators.fs" />
        <Compile Include="Model.fs" />
        <Compile Include="Examples.fs" />
        <Compile Include="Laws.fs" />
        <Compile Include="RelationLaws.fs" />
        <Compile Include="Regressions.fs" />
        <Compile Include="GeneratorChecks.fs" />
        <Compile Include="Program.fs" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\src\Interval\Interval.fsproj" />
    </ItemGroup>

</Project>
