<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsPublishable>false</IsPublishable>
        <IsPackable>false</IsPackable>
        <GenerateProgramFile>false</GenerateProgramFile>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <!-- NU1608: YoloDev.Expecto.TestSdk declares Expecto < 10 but runs correctly against Expecto 11. -->
        <NoWarn>$(NoWarn);NU1608</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Expecto" Version="11.1.1" />
        <PackageReference Include="Expecto.FsCheck" Version="11.1.1" />
        <PackageReference Include="FsCheck" Version="3.6.0" />
        <PackageReference Include="YoloDev.Expecto.TestSdk" Version="1.0.0" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
        <PackageReference Include="coverlet.msbuild" Version="10.1.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="Shared.fs" />
        <Compile Include="TryCreate.fs" />
        <Compile Include="Intersection.fs" />
        <Compile Include="Union.fs" />
        <Compile Include="Merge.fs" />
        <Compile Include="Relate.fs" />
        <Compile Include="Properties.fs" />
        <Compile Include="Program.fs" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\src\Interval\Interval.fsproj" />
    </ItemGroup>

</Project>
